#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        cap_sen: cap_sen {
            compatible = "zmk,behavior-hold-tap";
            label = "CAP_SEN";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "MOUSE_LAYER";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <200>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <0>;
        };

        scroll: scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "SCROLL";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
        };

        mok: mok {
            compatible = "zmk,behavior-hold-tap";
            label = "MOK";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <0>;
        };

        // sym_ru symbols: plain tap types the symbol in the RU OS layout, but
        // with Ctrl/Alt/GUI held send the same keycode as sym_en so hotkeys match.
        ru_fslh: ru_fslh {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_FSLH";
            bindings = <&kp KP_DIVIDE>, <&kp FSLH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_colon: ru_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_COLON";
            bindings = <&kp RU_COLON>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_semi: ru_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_SEMI";
            bindings = <&kp RU_SEMI>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        // Symbols missing from the plain RU layout. The OS uses ru(typo)
        // (Hyprland kb_variant ",typo"), which has them on AltGr (right Alt):
        // a plain tap sends RA(key) / RA(LS(key)). With Ctrl/Alt/GUI held the
        // same keycode as sym_en is sent instead, so hotkeys match (Hyprland
        // matches binds on the first, us, layout).
        ru_lt: ru_lt {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_LT";
            bindings = <&kp RA(N9)>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_gt: ru_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_GT";
            bindings = <&kp RA(N0)>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_caret: ru_caret {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_CARET";
            bindings = <&kp RA(N6)>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_grave: ru_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_GRAVE";
            bindings = <&kp RA(GRAVE)>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_tilde: ru_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_TILDE";
            bindings = <&kp RA(LS(GRAVE))>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_lbkt: ru_lbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_LBKT";
            bindings = <&kp RA(LBKT)>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_rbkt: ru_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_RBKT";
            bindings = <&kp RA(RBKT)>, <&kp RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_lbrc: ru_lbrc {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_LBRC";
            bindings = <&kp RA(LS(LBKT))>, <&kp LBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_rbrc: ru_rbrc {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_RBRC";
            bindings = <&kp RA(LS(RBKT))>, <&kp RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_amps: ru_amps {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_AMPS";
            bindings = <&kp RA(N7)>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_hash: ru_hash {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_HASH";
            bindings = <&kp RA(N3)>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_pipe: ru_pipe {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_PIPE";
            bindings = <&kp RA(BSLH)>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_dllr: ru_dllr {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_DLLR";
            bindings = <&kp RA(N4)>, <&kp DLLR>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_at: ru_at {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_AT";
            bindings = <&kp RA(N2)>, <&kp AT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_sqt: ru_sqt {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_SQT";
            bindings = <&kp RA(LS(N2))>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        // nav_ru overlay: `,` and `.` typed natively in the RU OS layout.
        ru_comma: ru_comma {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_COMMA";
            bindings = <&kp RU_COMMA>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_dot: ru_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_DOT";
            bindings = <&kp RU_DOT>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        hrmlctrlru: hrmlctrlru {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLCTRLRU";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&lctrlru>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        hrmlaltru: hrmlaltru {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLALTRU";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&laltru>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        hrmlguiru: hrmlguiru {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLGUIRU";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&lguiru>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        hrmlshiftru: hrmlshiftru {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMLSHIFTRU";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&lshiftru>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <0>;
            excluded-positions = <>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(NUMBER_2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(NUMBER_1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        lctrlru: modru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&to_ru>;

            label = "MODRU";
        };

        laltru: laltru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&to_ru>;

            label = "LALTRU";
        };

        lguiru: lguiru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&to_ru>;

            label = "LGUIRU";
        };

        lshiftru: lshiftru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_tap>,
                <&to_ru>;

            label = "LSHIFTRU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp TAB    &kp Q         &kp W        &kp E         &kp R              &kp T                                      &kp Y         &kp U               &kp I        &kp O        &kp P            &kp EXCLAMATION
&layer_ru  &hrm LCTRL A  &hrm LALT S  &hrm LGUI D   &hrm LEFT_SHIFT F  &kp G                                      &kp H         &hrm RIGHT_SHIFT J  &hrm RGUI K  &hrm RALT L  &hrm RCTRL SEMI  &kp SQT
&kp DQT    &kp Z         &kp X        &kp C         &kp V              &kp B                                      &kp N         &kp M               &kp MINUS    &kp HASH     &kp SLASH        &kp DELETE
                         &kp ESC      &kp QUESTION  &mo 6              &mok 2 SPACE  &kp BACKSPACE    &kp RETURN  &mok 3 SPACE  &trans              &kp COMMA    &kp DOT
            >;

            display-name = "En";
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp TAB           &kp Q         &kp W            &kp E             &kp R              &kp T                                      &kp Y         &kp U               &kp I             &kp O             &kp P              &kp LEFT_BRACKET
&layer_en         &hrm LCTRL A  &hrm LEFT_ALT S  &hrm LEFT_GUI D   &hrm LEFT_SHIFT F  &kp G                                      &kp H         &hrm RIGHT_SHIFT J  &hrm RIGHT_GUI K  &hrm LEFT_ALT L   &hrm RCTRL SEMI    &kp SQT
&kp LS(NUMBER_2)  &kp Z         &kp X            &kp C             &kp V              &kp B                                      &kp N         &kp M               &kp COMMA         &kp DOT           &kp RIGHT_BRACKET  &kp DELETE
                                &kp ESC          &kp LS(NUMBER_7)  &mo 6              &mok 2 SPACE  &kp BACKSPACE    &kp RETURN  &mok 4 SPACE  &trans              &kp LS(SLASH)     &kp SLASH
            >;
        };

        nav {
            bindings = <
&kp LC(X)           &kp LC(LS(LEFT_ARROW))  &kp PAGE_DOWN    &kp UP          &kp PAGE_UP      &kp LC(LS(RIGHT_ARROW))                    &kp CLEAR        &kp N7         &kp N8     &kp N9   &kp EQUAL     &kp INSERT
&kp LA(UP_ARROW)    &kp LC(LEFT_ARROW)      &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(RIGHT_ARROW)                        &kp KP_DIVIDE    &kp N4         &kp N5     &kp N6   &kp KP_MINUS  &kp UNDERSCORE
&kp LA(DOWN_ARROW)  &kp LA(LEFT_ARROW)      &kp HOME         &kp LGUI        &kp END          &kp LA(RIGHT_ARROW)                        &kp KP_MULTIPLY  &kp N1         &kp N2     &kp N3   &kp PLUS      &kp DELETE
                                            &kp LC(LS(TAB))  &kp LC(TAB)     &trans           &trans                   &trans    &kp N0  &mo 5            &kp BACKSPACE  &kp COMMA  &kp DOT
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &trans  &kp LT         &kp CARET  &kp GT    &kp GRAVE                     &trans    &kp LBKT     &kp UNDER  &kp RBKT  &trans    &trans
&trans  &trans  &kp LPAR       &kp COLON  &kp RPAR  &kp AMPS                      &kp HASH  &kp LBRC     &kp SEMI   &kp RBRC  &kp EXCL  &trans
&trans  &trans  &kp BACKSLASH  &kp PIPE   &kp FSLH  &trans                        &trans    &kp PERCENT  &kp TILDE  &kp DLLR  &trans    &trans
                &trans         &trans     &kp AT    &mo 5      &kp SQT    &trans  &trans    &trans       &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&trans  &kp RU_CYRILLIC_IO  &ru_lt         &ru_caret     &ru_gt         &ru_grave                     &trans    &ru_lbkt     &kp UNDER    &ru_rbkt  &trans    &trans
&trans  &kp RU_NUMERO       &kp LPAR       &ru_colon     &kp RPAR       &ru_amps                      &ru_hash  &ru_lbrc     &ru_semi     &ru_rbrc  &kp EXCL  &trans
&trans  &trans              &kp BACKSLASH  &ru_pipe      &ru_fslh       &trans                        &trans    &kp PERCENT  &ru_tilde    &ru_dllr  &trans    &trans
                            &trans         &trans        &ru_at         &mo 5      &ru_sqt    &trans  &trans    &trans       &trans       &trans
            >;
        };

        adj {
            bindings = <
&kp LG(LC(LS(PRINTSCREEN)))  &kp LG(LS(PRINTSCREEN))  &kp F9  &kp F10  &kp F11  &kp F12                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4          &bt BT_CLR
&kp LC(PRINTSCREEN)          &kp PRINTSCREEN          &kp F5  &kp F6   &kp F7   &kp F8                   &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &kp C_BRIGHTNESS_INC  &kp CAPSLOCK
&kp LG(LC(PRINTSCREEN))      &kp LG(PRINTSCREEN)      &kp F1  &kp F2   &kp F3   &kp F4                   &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_BRIGHTNESS_DEC  &tog 9
                                                      &trans  &trans   &none    &none    &none    &none  &none         &none         &trans            &trans
            >;

            display-name = "Adjust";
        };

        mouse {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &mo 7   &mkp MB3  &mkp MB2  &mkp MB1  &mo 8                     &mo 8   &mkp MB1  &mkp MB2  &mkp MB3  &mo 7   &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Sniper";
        };

        game {
            bindings = <
&kp H  &kp TAB         &kp Q    &kp W  &kp E   &kp R                              &trans  &trans  &trans  &trans  &trans  &trans
&kp T  &kp LEFT_SHIFT  &kp A    &kp S  &kp D   &kp F                              &trans  &trans  &trans  &trans  &trans  &trans
&kp B  &kp LCTRL       &kp Z    &kp X  &kp C   &kp V                              &trans  &trans  &trans  &trans  &trans  &tog 9
                       &kp TAB  &kp G  &mo 10  &kp SPACE  &kp LEFT_ALT    &trans  &trans  &trans  &trans  &trans
            >;

            label = "Game";
        };

        gamenums {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &trans  &trans  &trans  &trans  &trans  &trans
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "Game Nums";
        };

        // Overlay on top of nav while the ru layer is active (see
        // conditional_layers): `,` and `.` typed natively in the RU OS layout.
        nav_ru {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans     &trans     &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &ru_comma  &ru_dot
            >;

            display-name = "Nav";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_ru {
            if-layers = <1 2>;
            then-layer = <11>;
        };
    };
};

// PMW3610 accepts 200..3200 CPI in steps of 200; anything else fails sensor init.
// CPI is applied by the right half firmware (the sensor lives there); the
// scalers below are applied by the central (right half, or qube dongle).
&trackball { cpi = <1000>; };

&trackball_listener {
    input-processors = <&zip_xy_scaler 9 10>;

    scroller {
        layers = <7>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 96>,
            <&zip_xy_to_scroll_mapper>;
    };

    sniper {
        layers = <8>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};
