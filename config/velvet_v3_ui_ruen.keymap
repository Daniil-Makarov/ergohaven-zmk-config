#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <scroll-snap.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {




        // Home-row mods: non-positional balanced. A mod becomes a hold as
        // soon as any other key is pressed and released while it is held,
        // so one-hand hotkeys (Super+S, Ctrl+C) work instantly. A plain
        // roll (first key released first) stays a tap; a misfire is only
        // possible on a nested roll. Positional HRM was tried and dropped:
        // same-hand hotkeys needed the mod held past tapping-term.
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        // Must be held for a second: protects destructive keys on adj.
        hold_bt: hold_bt {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&bt>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            flavor = "tap-preferred";
        };

        hold_boot: hold_boot {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&bootloader>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            flavor = "tap-preferred";
        };

        mok: mok {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <0>;
        };

        // sym_ru symbols: plain tap types the symbol in the RU OS layout, but
        // with Ctrl/Alt/GUI held send the same keycode as sym_en so hotkeys match.
        ru_fslh: ru_fslh {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_FSLH>, <&kp FSLH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_colon: ru_colon {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_COLON>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_semi: ru_semi {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_SEMI>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        // Symbols missing from the plain RU layout. The OS uses ru(typo)
        // (Hyprland kb_variant ",typo"), which has them on AltGr (right Alt):
        // a plain tap sends RA(key) / RA(LS(key)). With Ctrl/Alt/GUI held the
        // same keycode as sym_en is sent instead, so hotkeys match (Hyprland
        // matches binds on the first, us, layout).
        ru_lt: ru_lt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N9)>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_gt: ru_gt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N0)>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_caret: ru_caret {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N6)>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_grave: ru_grave {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(GRAVE)>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_tilde: ru_tilde {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(LS(GRAVE))>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_lbkt: ru_lbkt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(LBKT)>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_rbkt: ru_rbkt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(RBKT)>, <&kp RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_lbrc: ru_lbrc {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(LS(LBKT))>, <&kp LBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_rbrc: ru_rbrc {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(LS(RBKT))>, <&kp RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_amps: ru_amps {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N7)>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_hash: ru_hash {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N3)>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_pipe: ru_pipe {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(BSLH)>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_dllr: ru_dllr {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N4)>, <&kp DLLR>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_at: ru_at {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(N2)>, <&kp AT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_sqt: ru_sqt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RA(LS(N2))>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        // ru layer punctuation (and the nav_ru overlay): typed natively in the
        // RU OS layout, same keycodes as the en layer when Ctrl/Alt/GUI is held.
        ru_qmark: ru_qmark {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_QMARK>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_dqt: ru_dqt {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_DQT>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_comma: ru_comma {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_COMMA>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_dot: ru_dot {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_DOT>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        // ru letters on the positions where the en layer has punctuation
        // (х б ю ъ over ! - # /): the letter on a plain tap, the en layer
        // keycode with Ctrl/Alt/GUI held, so hotkeys stay on the same keys in
        // both layers (Ctrl+-, Ctrl+/, Super+-).
        ru_ha: ru_ha {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_CYRILLIC_HA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_be: ru_be {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_CYRILLIC_BE>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_yu: ru_yu {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_CYRILLIC_YU>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };

        ru_hard: ru_hard {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI|MOD_RCTL|MOD_RALT|MOD_RGUI)>;
        };





    };


    macros {
        // Layer + OS layout switch in one key. F13 / F14 go out first: the OS
        // keymap maps them to "first / second layout" right in xkb
        // (custom:f13_f14_select in the nix repo), so the layout changes in the
        // key stream itself and the next key is always typed in the new one.
        // The layer changes while F13 / F14 is held, so both switch at the
        // same moment. Alt+Shift+1 / Alt+Shift+2 follow: Hyprland binds that
        // run `hyprctl switchxkblayout all` (~12 ms later, an external
        // process) to bring the other keyboards to the same layout.
        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp F13>,
                <&macro_tap &to 0>,
                <&macro_release &kp F13>,
                <&macro_tap &kp LS(LA(NUMBER_1))>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp F14>,
                <&macro_tap &to 1>,
                <&macro_release &kp F14>,
                <&macro_tap &kp LS(LA(NUMBER_2))>;
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp TAB    &kp Q         &kp W        &kp E         &kp R              &kp T                                      &kp Y         &kp U               &kp I        &kp O        &kp P            &kp EXCLAMATION
&layer_ru  &hrm LCTRL A  &hrm LALT S  &hrm LGUI D   &hrm LEFT_SHIFT F  &kp G                                      &kp H         &hrm RIGHT_SHIFT J  &hrm RGUI K  &hrm RALT L  &hrm RCTRL SEMI  &kp SQT
&kp DQT    &kp Z         &kp X        &kp C         &kp V              &kp B                                      &kp N         &kp M               &kp MINUS    &kp HASH     &kp SLASH        &kp DELETE
                         &kp ESC      &kp QUESTION  &mo 6              &mok 2 SPACE  &kp BACKSPACE    &kp RETURN  &mok 3 SPACE  &trans              &kp COMMA    &kp DOT
            >;

            display-name = "En";
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp TAB           &kp Q         &kp W            &kp E             &kp R              &kp T                                      &kp Y         &kp U               &kp I             &kp O             &kp P              &ru_ha
&layer_en         &hrm LCTRL A  &hrm LEFT_ALT S  &hrm LEFT_GUI D   &hrm LEFT_SHIFT F  &kp G                                      &kp H         &hrm RIGHT_SHIFT J  &hrm RIGHT_GUI K  &hrm LEFT_ALT L   &hrm RCTRL SEMI    &kp SQT
&ru_dqt           &kp Z         &kp X            &kp C             &kp V              &kp B                                      &kp N         &kp M               &ru_be            &ru_yu            &ru_hard           &kp DELETE
                                &kp ESC          &ru_qmark         &mo 6              &mok 2 SPACE  &kp BACKSPACE    &kp RETURN  &mok 4 SPACE  &trans              &ru_comma         &ru_dot
            >;
        };

        nav {
            bindings = <
&kp LC(X)           &kp LC(LS(LEFT_ARROW))  &kp PAGE_DOWN    &kp UP          &kp PAGE_UP      &kp LC(LS(RIGHT_ARROW))                    &kp DELETE       &kp N7         &kp N8     &kp N9   &kp EQUAL     &kp INSERT
&kp LA(UP_ARROW)    &kp LC(LEFT_ARROW)      &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(RIGHT_ARROW)                        &kp FSLH         &kp N4         &kp N5     &kp N6   &kp MINUS     &kp UNDERSCORE
&kp LA(DOWN_ARROW)  &kp LA(LEFT_ARROW)      &kp HOME         &kp LGUI        &kp END          &kp LA(RIGHT_ARROW)                        &kp STAR         &kp N1         &kp N2     &kp N3   &kp PLUS      &kp DELETE
                                            &kp LC(LS(TAB))  &kp LC(TAB)     &trans           &trans                   &trans    &kp N0  &mo 5            &trans         &kp COMMA  &kp DOT
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &trans  &kp LT         &kp CARET  &kp GT    &kp GRAVE                     &trans    &kp LBKT     &kp UNDER  &kp RBKT  &trans    &trans
&trans  &trans  &kp LPAR       &kp COLON  &kp RPAR  &kp AMPS                      &kp HASH  &kp LBRC     &kp SEMI   &kp RBRC  &kp EXCL  &trans
&trans  &trans  &kp BACKSLASH  &kp PIPE   &kp FSLH  &trans                        &trans    &kp PERCENT  &kp TILDE  &kp DLLR  &trans    &trans
                &trans         &trans     &kp AT    &mo 5      &kp SQT    &trans  &trans    &trans       &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&trans  &kp RU_CYRILLIC_IO  &ru_lt         &ru_caret     &ru_gt         &ru_grave                     &trans    &ru_lbkt     &kp UNDER    &ru_rbkt  &trans    &trans
&trans  &kp RU_NUMERO       &kp LPAR       &ru_colon     &kp RPAR       &ru_amps                      &ru_hash  &ru_lbrc     &ru_semi     &ru_rbrc  &kp EXCL  &trans
&trans  &trans              &kp BACKSLASH  &ru_pipe      &ru_fslh       &trans                        &trans    &kp PERCENT  &ru_tilde    &ru_dllr  &trans    &trans
                            &trans         &trans        &ru_at         &mo 5      &ru_sqt    &trans  &trans    &trans       &trans       &trans
            >;
        };

        // F24 / F23 (right half, next to volume): brightness up / down of the
        // qube dongle screen, which listens for these keycodes. The host has
        // no binds on them.
        adj {
            bindings = <
&kp LG(LC(LS(PRINTSCREEN)))  &kp LG(LS(PRINTSCREEN))  &kp F9  &kp F10  &kp F11  &kp F12                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4          &hold_bt BT_CLR_CMD 0
&kp LC(PRINTSCREEN)          &kp PRINTSCREEN          &kp F5  &kp F6   &kp F7   &kp F8                   &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &kp F24               &kp LS(CAPSLOCK)
&kp LG(LC(PRINTSCREEN))      &kp LG(PRINTSCREEN)      &kp F1  &kp F2   &kp F3   &kp F4                   &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp F23               &tog 9
                                                      &hold_boot 0 0  &studio_unlock  &none  &none  &none    &none  &none  &trans  &none  &hold_boot 0 0
            >;

            display-name = "Adjust";
        };

        mouse {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &mo 7   &mkp MB3  &mkp MB2  &mkp MB1  &mo 8                     &mo 8   &mkp MB1  &mkp MB2  &mkp MB3  &mo 7   &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
                &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans
            >;

            display-name = "Sniper";
        };

        game {
            bindings = <
&kp H  &kp TAB         &kp Q    &kp W  &kp E   &kp R                              &trans  &trans  &trans  &trans  &trans  &trans
&kp T  &kp LEFT_SHIFT  &kp A    &kp S  &kp D   &kp F                              &trans  &trans  &trans  &trans  &trans  &trans
&kp B  &kp LCTRL       &kp Z    &kp X  &kp C   &kp V                              &trans  &trans  &trans  &trans  &trans  &tog 9
                       &kp ESC  &kp G  &mo 10  &kp SPACE  &kp LEFT_ALT    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Game";
        };

        gamenums {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &trans  &trans  &trans  &trans  &trans  &trans
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Game Nums";
        };

        // Overlay on top of nav while the ru layer is active (see
        // conditional_layers): `/`, `,` and `.` typed natively in the RU OS layout.
        nav_ru {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &ru_fslh  &trans  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans  &trans  &trans     &trans     &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &ru_comma  &ru_dot
            >;

            display-name = "Nav";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_ru {
            if-layers = <1 2>;
            then-layer = <11>;
        };
    };
};

// PMW3610 accepts 200..3200 CPI in steps of 200; anything else fails sensor init.
// CPI is applied by the right half firmware (the sensor lives there); the
// scalers below are applied by the central (right half, or qube dongle).
&trackball { cpi = <1000>; };

&trackball_listener {
    input-processors = <&zip_xy_scaler 9 10>;

    // With CONFIG_ZMK_POINTING_SMOOTH_SCROLLING the host gets 16 scroll units
    // per wheel notch, so 1/6 here is one notch per 96 sensor counts.
    // zip_scroll_snap locks the scroll to the dominant axis (no sideways
    // drift while scrolling vertically).
    scroller {
        layers = <7>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 6>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_snap>;
    };

    sniper {
        layers = <8>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};
